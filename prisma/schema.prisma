generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AuthToken {
  merchantId      String
  authorizedAppId String   @id
  salesChannelId  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  accessToken     String
  tokenType       String
  expiresIn       Int
  expireDate      DateTime
  refreshToken    String
  scope           String?

  @@index([merchantId, updatedAt])
}

model Review {
  id                     String                @id @default(uuid())
  storeId                String
  productId              String
  rating                 Int
  comment                String?               @db.VarChar(2000)
  author                 String
  email                  String?
  status                 String                @default("pending")
  merchantReply          String?               @db.VarChar(2000)
  images                 String?
  hasImages              Boolean               @default(false)
  hasVideo               Boolean               @default(false)
  moderationVersion      Int                   @default(0)
  reviewRequestId        String?               @unique
  reviewRequestReceiptId String?               @unique
  verifiedBuyer          Boolean               @default(false)
  verifiedAt             DateTime?
  verificationSource     String?               @db.VarChar(64)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  productName            String?
  slug                   String
  title                  String?
  media                  ReviewMedia[]
  reviewRequest          ReviewRequest?        @relation(fields: [reviewRequestId], references: [id], onDelete: SetNull)
  reviewRequestReceipt   ReviewRequestReceipt? @relation(fields: [reviewRequestReceiptId], references: [id], onDelete: SetNull)

  @@index([storeId, productId, status])
  @@index([storeId, productId, status, hasVideo])
  @@index([storeId, status])
  @@index([storeId, slug, status])
  @@index([storeId, verifiedBuyer, createdAt])
}

model ReviewMedia {
  id                      String    @id @default(uuid())
  reviewId                String
  storeId                 String
  productId               String
  url                     String    @db.VarChar(2048)
  publicId                String    @unique @db.VarChar(512)
  assetId                 String?   @db.VarChar(128)
  version                 String?   @db.VarChar(64)
  resourceType            String    @default("image") @db.VarChar(32)
  provider                String    @default("aws_s3") @db.VarChar(64)
  providerAssetId         String?   @db.VarChar(512)
  posterUrl               String?   @db.VarChar(2048)
  durationMs              Int?
  processingStatus        String    @default("ready") @db.VarChar(32)
  sourceProvider          String?   @db.VarChar(64)
  sourceAssetId           String?   @db.VarChar(1024)
  format                  String?   @db.VarChar(32)
  mimeType                String?   @db.VarChar(128)
  width                   Int?
  height                  Int?
  bytes                   Int?
  sourceChecksumAlgorithm String?   @db.VarChar(16)
  sourceChecksumSha256    String?   @db.VarChar(128)
  metadataSource          String    @default("unknown") @db.VarChar(64)
  metadataStatus          String    @default("pending") @db.VarChar(64)
  metadataFetchedAt       DateTime?
  variantStatus           String    @default("pending") @db.VarChar(32)
  variantGeneratedAt      DateTime?
  variantPublishedAt      DateTime?
  variantRevokedAt        DateTime?
  variantErrorCode        String?   @db.VarChar(128)
  variantManifest         Json?
  position                Int
  visible                 Boolean   @default(false)
  createdAt               DateTime  @default(now())
  review                  Review    @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, position])
  @@index([reviewId, position])
  @@index([storeId, productId, visible, createdAt])
  @@index([metadataStatus, createdAt])
  @@index([provider, providerAssetId])
  @@index([provider, storeId, providerAssetId])
  @@index([provider, resourceType, variantStatus, createdAt])
  @@index([processingStatus, createdAt])
}

model ProductReviewSummary {
  id                String    @id @default(uuid())
  storeId           String
  productId         String
  approvedCount     Int       @default(0)
  ratingSum         Int       @default(0)
  averageRating     Float     @default(0)
  rating1Count      Int       @default(0)
  rating2Count      Int       @default(0)
  rating3Count      Int       @default(0)
  rating4Count      Int       @default(0)
  rating5Count      Int       @default(0)
  photoReviewCount  Int       @default(0)
  photoRating1Count Int       @default(0)
  photoRating2Count Int       @default(0)
  photoRating3Count Int       @default(0)
  photoRating4Count Int       @default(0)
  photoRating5Count Int       @default(0)
  mediaReviewCount  Int       @default(0)
  mediaRating1Count Int       @default(0)
  mediaRating2Count Int       @default(0)
  mediaRating3Count Int       @default(0)
  mediaRating4Count Int       @default(0)
  mediaRating5Count Int       @default(0)
  lastReviewAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([storeId, productId])
}

model StoreSettings {
  id                String   @id @default(uuid())
  storeId           String   @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  /// JSON map of storefrontId -> ikas scriptId
  storefrontScripts Json?
  /// Non-sensitive published storefront/theme metadata for runtime adapter selection
  storefrontTheme   Json?
  /// Monthly video-review quota. Zero keeps video uploads disabled for the store.
  videoMonthlyLimit Int      @default(0)
}

model WidgetSettings {
  id        String   @id @default(uuid())
  storeId   String
  widgetId  String
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, widgetId])
  @@index([storeId])
}

model ProductSnapshot {
  id            String    @id @default(uuid())
  storeId       String
  productId     String
  slug          String?
  name          String?
  ikasUpdatedAt DateTime?
  lastSyncedAt  DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([storeId, productId])
  @@index([storeId, slug])
}

// Provider-agnostic registry of uploads that are not yet attached to a Review.
// The legacy model name is intentionally retained for additive migration
// safety. Provider-specific cleanup is routed through the media adapters.
// See ADR_0012 and ADR_0031 for the lifecycle contracts.
model PendingReviewImage {
  publicId                String    @id
  storeId                 String?
  productId               String?
  uploadSessionId         String?   @unique
  url                     String?   @db.VarChar(2048)
  assetId                 String?   @db.VarChar(128)
  version                 String?   @db.VarChar(64)
  resourceType            String    @default("image") @db.VarChar(32)
  provider                String    @default("aws_s3") @db.VarChar(64)
  providerAssetId         String?   @db.VarChar(512)
  posterUrl               String?   @db.VarChar(2048)
  durationMs              Int?
  processingStatus        String    @default("ready") @db.VarChar(32)
  sourceProvider          String?   @db.VarChar(64)
  sourceAssetId           String?   @db.VarChar(1024)
  format                  String?   @db.VarChar(32)
  mimeType                String?   @db.VarChar(128)
  width                   Int?
  height                  Int?
  bytes                   Int?
  sourceChecksumAlgorithm String?   @db.VarChar(16)
  sourceChecksumSha256    String?   @db.VarChar(128)
  metadataSource          String    @default("unknown") @db.VarChar(64)
  metadataStatus          String    @default("pending") @db.VarChar(64)
  metadataFetchedAt       DateTime?
  variantStatus           String    @default("pending") @db.VarChar(32)
  variantGeneratedAt      DateTime?
  variantErrorCode        String?   @db.VarChar(128)
  variantManifest         Json?
  uploadExpiresAt         DateTime?
  uploadRegisteredAt      DateTime?
  createdAt               DateTime  @default(now())
  ipHash                  String?

  @@index([createdAt])
  @@index([storeId, createdAt])
  @@index([metadataStatus, createdAt])
  @@index([provider, providerAssetId])
  @@index([provider, storeId, providerAssetId])
  @@index([provider, variantStatus, createdAt])
  @@index([processingStatus, createdAt])
}

// Durable state for the video upload -> provider processing lifecycle. The
// opaque client token is never stored; only its SHA-256 hash is persisted.
//
// ADR_0032 (Mux migration): video uploads use Mux direct uploads and Mux asset
// identifiers. Provider is still written explicitly by the app; no DB default.
model VideoUploadSession {
  id                String                        @id @default(uuid())
  tokenHash         String                        @unique @db.VarChar(64)
  storeId           String
  productId         String
  status            String                        @default("initiated") @db.VarChar(32)
  mimeType          String                        @db.VarChar(128)
  bytes             Int
  fileFingerprint   String?                       @db.VarChar(128)
  provider          String?                       @db.VarChar(64)
  providerUploadId  String?                       @db.VarChar(256)
  providerAssetId   String?                       @db.VarChar(256)
  signedPlaybackId  String?                       @db.VarChar(256)
  publicPlaybackId  String?                       @db.VarChar(256)
  publicId          String?                       @unique @db.VarChar(512)
  playbackUrl       String?                       @db.VarChar(2048)
  posterUrl         String?                       @db.VarChar(2048)
  durationMs        Int?
  quotaState        String                        @default("reserved") @db.VarChar(32)
  reservedMonth     DateTime                      @db.Date
  expiresAt         DateTime
  consumedAt        DateTime?
  errorCode         String?                       @db.VarChar(128)
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt
  performanceSample VideoUploadPerformanceSample?

  @@unique([provider, providerUploadId])
  @@unique([provider, providerAssetId])
  @@index([storeId, productId, status])
  @@index([status, expiresAt])
  @@index([createdAt])
}

// Monthly quota counters. Reservations are taken before a Mux direct upload is
// created so concurrent initiate requests cannot oversubscribe a merchant.
model StoreVideoUsage {
  storeId       String
  month         DateTime @db.Date
  reservedCount Int      @default(0)
  consumedCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@id([storeId, month])
  @@index([month])
}

// Transactional outbox for provider mutations. Provider ids survive review or
// pending-row deletion and every action is idempotent through dedupeKey.
model MediaProviderJob {
  id              String    @id @default(uuid())
  dedupeKey       String    @unique @db.VarChar(256)
  storeId         String?
  reviewId        String?
  mediaId         String?
  uploadSessionId String?
  provider        String    @db.VarChar(64)
  action          String    @db.VarChar(64)
  resourceType    String    @db.VarChar(32)
  payload         Json
  status          String    @default("pending") @db.VarChar(32)
  attempts        Int       @default(0)
  maxAttempts     Int       @default(8)
  availableAt     DateTime  @default(now())
  lockedAt        DateTime?
  completedAt     DateTime?
  lastErrorCode   String?   @db.VarChar(128)
  lastErrorAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, availableAt])
  @@index([provider, action, createdAt])
  @@index([uploadSessionId])
  @@index([reviewId])
}

// Short-lived provider mutation lease. The monotonically increasing version is
// a fencing token, so a worker that outlives its lease cannot be treated as the
// current owner when it records its result.
model MediaProviderLease {
  key          String   @id @db.VarChar(256)
  ownerJobId   String
  leaseVersion Int      @default(1)
  lockedUntil  DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([lockedUntil])
}

// Provider webhook idempotency + audit (ADR_0032). Dedup/audit ONLY - the
// actual provider work + retry reuse the MediaProviderJob outbox +
// MediaProviderLease. Linked to a session by the natural key (sessionId /
// providerUploadId / providerAssetId). Payload is never persisted (only a
// digest + normalized ids); signed URLs/tokens are never stored.
model WebhookEvent {
  id                     String    @id @default(uuid())
  provider               String    @db.VarChar(64)
  providerEventId        String    @db.VarChar(256)
  eventType              String    @db.VarChar(128)
  providerUploadId       String?   @db.VarChar(256)
  providerAssetId        String?   @db.VarChar(256)
  sessionId              String?
  providerEventCreatedAt DateTime?
  receivedAt             DateTime  @default(now())
  processedAt            DateTime?
  status                 String    @default("received") @db.VarChar(32)
  lastError              String?   @db.VarChar(512)
  payloadDigest          String?   @db.VarChar(64)

  @@unique([provider, providerEventId])
  @@index([status, receivedAt])
}

// Non-sensitive client-side upload timing for Mux performance diagnosis.
// Stores one sanitized sample per video session; never stores tokens, upload
// URLs, signed playback URLs, raw user-agent, IP, or file names.
model VideoUploadPerformanceSample {
  id               String             @id @default(uuid())
  uploadSessionId  String             @unique
  storeId          String
  productId        String
  provider         String             @db.VarChar(64)
  fileBytes        Int
  chunkSizeKb      Int
  chunkAttempts    Int
  retryClicks      Int                @default(0)
  upchunkErrors    Int                @default(0)
  firstErrorCode   String?            @db.VarChar(128)
  directUploadMs   Int?
  completeMs       Int?
  processingPollMs Int?
  totalClientMs    Int?
  finalStatus      String             @db.VarChar(32)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  uploadSession    VideoUploadSession @relation(fields: [uploadSessionId], references: [id], onDelete: Cascade)

  @@index([storeId, productId, createdAt])
  @@index([provider, finalStatus, createdAt])
  @@index([createdAt])
}

// --- Cleanup hardening (ADR_0030) -------------------------------------------

// Audit log: one durable row per cleanup-images cron run. Records what the
// orphan cleanup scanned / quarantined / released / deleted, whether the safety
// breaker tripped (and why), and a sample of deleted publicIds for recovery.
model MediaCleanupRun {
  id             String    @id @default(uuid())
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  status         String    @default("ok") @db.VarChar(32) // ok | tripped | error | skipped
  trigger        String    @default("cron") @db.VarChar(32) // cron | manual
  scanned        Int       @default(0)
  usedCount      Int       @default(0)
  candidates     Int       @default(0) // current orphans flagged this run
  quarantinedNew Int       @default(0) // newly added to quarantine this run
  released       Int       @default(0) // un-quarantined (no longer orphan) this run
  deleted        Int       @default(0) // hard-deleted (swept) this run
  breakerTripped Boolean   @default(false)
  breakerReason  String?   @db.VarChar(128)
  forced         Boolean   @default(false)
  sampleDeleted  Json? // up to ~50 deleted publicIds, for forensics/recovery
  error          String?   @db.VarChar(512)
  durationMs     Int?

  @@index([startedAt])
  @@index([status, startedAt])
}

// Idempotency guard for QStash scheduled maintenance jobs. The composite key
// represents one logical scheduled run, while status/lockedUntil let failed or
// stale attempts be retried without overlapping a currently running attempt.
model ScheduledJobRunLock {
  task         String    @db.VarChar(64)
  scheduleSlot String    @db.VarChar(32)
  status       String    @default("processing") @db.VarChar(32)
  attempts     Int       @default(1)
  lockedUntil  DateTime?
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  lastError    String?   @db.VarChar(512)
  updatedAt    DateTime  @updatedAt

  @@id([task, scheduleSlot])
  @@index([startedAt])
  @@index([status, startedAt])
}

// Two-phase orphan deletion (ADR_0030). The monthly cleanup-images cron MARKS an
// orphan here (phase 1) instead of deleting it; a later run hard-DELETES it
// (phase 2) only if it is still orphaned after the grace window. Rows are
// removed automatically when an asset stops being an orphan (e.g. its review is
// re-found), giving a recoverable grace period before any irreversible delete.
model OrphanImageQuarantine {
  publicId      String   @id @db.VarChar(512)
  storeId       String?
  reason        String   @default("orphan_scan") @db.VarChar(64)
  quarantinedAt DateTime @default(now())
  lastSeenAt    DateTime @default(now()) // last run it was still seen as orphan
  scanCount     Int      @default(1) // number of runs it has been flagged

  @@index([quarantinedAt])
  @@index([storeId])
}

// --- Review request email lifecycle (ADR_0036) ------------------------------

model IkasStoreInstallation {
  storeId          String    @id
  authorizedAppId  String    @unique @db.VarChar(128)
  generation       Int       @default(1)
  stateVersion     Int       @default(1)
  status           String    @default("active") @db.VarChar(32)
  activatedAt      DateTime  @default(now())
  erasureStartedAt DateTime?
  erasedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status, updatedAt])
}

model ReviewEmailSettings {
  id                        String    @id @default(uuid())
  storeId                   String    @unique
  enabled                   Boolean   @default(false)
  triggerMode               String    @default("delivery") @db.VarChar(32)
  consentMode               String    @default("strict_notifications_accepted") @db.VarChar(64)
  firstDelayDays            Int       @default(1)
  reminderEnabled           Boolean   @default(true)
  reminderDelayDays         Int       @default(1)
  maxReminderCount          Int       @default(1)
  senderDisplayName         String?   @db.VarChar(128)
  replyToEmailHash          String?   @db.VarChar(128)
  replyToEmailEncrypted     String?   @db.Text
  replyToName               String?   @db.VarChar(128)
  logoUrl                   String?   @db.VarChar(2048)
  buttonColor               String?   @db.VarChar(32)
  locale                    String    @default("tr") @db.VarChar(16)
  templateVersion           String    @default("default_v1") @db.VarChar(64)
  orderWebhookStatus        String    @default("unregistered") @db.VarChar(32)
  orderWebhookVerifiedAt    DateTime?
  orderWebhookLastErrorCode String?   @db.VarChar(128)
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@index([enabled, updatedAt])
}

model IkasOrderWebhookEvent {
  id              String    @id @default(uuid())
  providerEventId String    @unique @db.VarChar(256)
  scope           String    @db.VarChar(128)
  storeId         String    @db.VarChar(128)
  authorizedAppId String    @db.VarChar(128)
  ikasOrderId     String?   @db.VarChar(128)
  payloadDigest   String?   @db.VarChar(64)
  status          String    @default("received") @db.VarChar(32)
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?
  lastErrorCode   String?   @db.VarChar(128)

  @@index([storeId, receivedAt])
  @@index([status, receivedAt])
  @@index([ikasOrderId])
}

model IkasOrderSnapshot {
  id                                String                  @id @default(uuid())
  storeId                           String
  authorizedAppId                   String                  @db.VarChar(128)
  ikasOrderId                       String                  @db.VarChar(128)
  orderNumber                       String?                 @db.VarChar(128)
  shippingMethod                    String                  @db.VarChar(64)
  orderStatus                       String                  @db.VarChar(64)
  orderPackageStatus                String?                 @db.VarChar(64)
  orderPaymentStatus                String?                 @db.VarChar(64)
  orderedAt                         DateTime?
  ikasUpdatedAt                     DateTime?
  notificationsAccepted             Boolean?
  guestCheckout                     Boolean?
  customerId                        String?                 @db.VarChar(128)
  customerEmailHash                 String?                 @db.VarChar(128)
  customerEmailFoldedHash           String?                 @db.VarChar(128)
  customerEmailHashKeyVersion       Int?
  customerEmailNormalizationVersion Int                     @default(1)
  customerEmailEncrypted            String?                 @db.Text
  createdAt                         DateTime                @default(now())
  updatedAt                         DateTime                @updatedAt
  lines                             IkasOrderLineSnapshot[]
  reviewRequests                    ReviewRequest[]

  @@unique([storeId, ikasOrderId])
  @@index([storeId, ikasUpdatedAt])
  @@index([storeId, customerEmailHash])
  @@index([storeId, customerEmailFoldedHash])
  @@index([orderPackageStatus, ikasUpdatedAt])
}

model IkasOrderLineSnapshot {
  id                  String            @id @default(uuid())
  storeId             String
  orderSnapshotId     String
  ikasOrderId         String            @db.VarChar(128)
  ikasOrderLineItemId String            @db.VarChar(128)
  productId           String            @db.VarChar(128)
  variantId           String?           @db.VarChar(128)
  lineStatus          String            @db.VarChar(64)
  lineStatusUpdatedAt DateTime?
  quantity            Float?
  productName         String?           @db.VarChar(512)
  variantName         String?           @db.VarChar(512)
  packageId           String?           @db.VarChar(128)
  packageStatus       String?           @db.VarChar(64)
  eligibleAt          DateTime?
  ineligibleReason    String?           @db.VarChar(128)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  orderSnapshot       IkasOrderSnapshot @relation(fields: [orderSnapshotId], references: [id], onDelete: Cascade)
  reviewRequests      ReviewRequest[]

  @@unique([storeId, ikasOrderLineItemId])
  @@index([orderSnapshotId])
  @@index([storeId, productId])
  @@index([storeId, eligibleAt])
  @@index([lineStatus, eligibleAt])
}

model ReviewRequest {
  id                                 String                 @id @default(uuid())
  storeId                            String
  productId                          String                 @db.VarChar(128)
  orderSnapshotId                    String
  orderLineSnapshotId                String
  receiptId                          String?                @unique
  status                             String                 @default("scheduled") @db.VarChar(32)
  eligibleAt                         DateTime?
  sendAfter                          DateTime?
  firstDelayDaysSnapshot             Int                    @default(1)
  reminderDelayDaysSnapshot          Int                    @default(1)
  maxReminderCountSnapshot           Int                    @default(1)
  triggerModeSnapshot                String                 @default("delivery") @db.VarChar(32)
  consentModeSnapshot                String                 @default("strict_notifications_accepted") @db.VarChar(64)
  notificationsAcceptedSnapshot      Boolean?
  templateVersionSnapshot            String                 @default("default_v1") @db.VarChar(64)
  localeSnapshot                     String                 @default("tr") @db.VarChar(16)
  recipientEmailHash                 String?                @db.VarChar(128)
  recipientEmailFoldedHash           String?                @db.VarChar(128)
  recipientEmailHashKeyVersion       Int?
  recipientEmailNormalizationVersion Int                    @default(1)
  recipientEmailEncrypted            String?                @db.Text
  firstSentAt                        DateTime?
  lastReminderSentAt                 DateTime?
  reminderCount                      Int                    @default(0)
  submittedAt                        DateTime?
  expiresAt                          DateTime?
  cancelledAt                        DateTime?
  cancellationReason                 String?                @db.VarChar(128)
  createdAt                          DateTime               @default(now())
  updatedAt                          DateTime               @updatedAt
  orderSnapshot                      IkasOrderSnapshot      @relation(fields: [orderSnapshotId], references: [id], onDelete: Restrict)
  orderLineSnapshot                  IkasOrderLineSnapshot  @relation(fields: [orderLineSnapshotId], references: [id], onDelete: Restrict)
  receipt                            ReviewRequestReceipt?  @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  tokens                             ReviewRequestToken[]
  sessions                           ReviewRequestSession[]
  jobs                               ReviewEmailJob[]
  review                             Review?

  @@unique([storeId, orderLineSnapshotId])
  @@index([orderSnapshotId])
  @@index([orderLineSnapshotId])
  @@index([status, sendAfter])
  @@index([storeId, status, sendAfter])
  @@index([storeId, productId, status])
}

model ReviewRequestToken {
  id               String                 @id @default(uuid())
  requestId        String
  attemptId        String                 @unique
  tokenHash        String                 @unique @db.VarChar(64)
  tokenKeyVersion  Int                    @default(1)
  status           String                 @default("prepared") @db.VarChar(32)
  expiresAt        DateTime?
  consumedAt       DateTime?
  revokedAt        DateTime?
  revocationReason String?                @db.VarChar(128)
  createdAt        DateTime               @default(now())
  request          ReviewRequest          @relation(fields: [requestId], references: [id], onDelete: Cascade)
  attempt          ReviewEmailAttempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  sessions         ReviewRequestSession[]

  @@index([requestId])
  @@index([status, expiresAt])
}

model ReviewRequestSession {
  id               String             @id @default(uuid())
  requestId        String
  tokenId          String
  sessionHash      String             @unique @db.VarChar(64)
  status           String             @default("active") @db.VarChar(32)
  expiresAt        DateTime
  consumedAt       DateTime?
  revokedAt        DateTime?
  revocationReason String?            @db.VarChar(128)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  request          ReviewRequest      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  token            ReviewRequestToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@index([requestId, status])
  @@index([tokenId])
  @@index([status, expiresAt])
}

model ReviewEmailJob {
  id               String               @id @default(uuid())
  requestId        String
  storeId          String
  productId        String               @db.VarChar(128)
  kind             String               @db.VarChar(32)
  sequence         Int                  @default(0)
  status           String               @default("pending") @db.VarChar(32)
  sendAfter        DateTime
  dedupeKey        String               @unique @db.VarChar(256)
  leaseOwner       String?              @db.VarChar(128)
  leaseExpiresAt   DateTime?
  dispatchedAt     DateTime?
  queueMessageId   String?              @db.VarChar(256)
  completedAt      DateTime?
  dispatchAttempts Int                  @default(0)
  lastErrorCode    String?              @db.VarChar(128)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  request          ReviewRequest        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  attemptsLog      ReviewEmailAttempt[]

  @@unique([requestId, kind, sequence])
  @@index([requestId, kind])
  @@index([storeId, status, sendAfter])
  @@index([kind, status, sendAfter])
  @@index([leaseExpiresAt])
}

model ReviewEmailAttempt {
  id                  String              @id @default(uuid())
  jobId               String
  attemptNumber       Int
  correlationId       String              @unique @db.VarChar(64)
  provider            String              @default("ses") @db.VarChar(64)
  providerMessageId   String?             @db.VarChar(256)
  recipientEmailHash  String?             @db.VarChar(128)
  templateVersion     String              @default("default_v1") @db.VarChar(64)
  locale              String              @default("tr") @db.VarChar(16)
  status              String              @default("prepared") @db.VarChar(32)
  sendInitiatedAt     DateTime?
  acceptedAt          DateTime?
  deliveryConfirmedAt DateTime?
  completedAt         DateTime?
  errorCode           String?             @db.VarChar(128)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  job                 ReviewEmailJob      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  events              ReviewEmailEvent[]
  token               ReviewRequestToken?

  @@unique([jobId, attemptNumber])
  @@index([jobId])
  @@index([provider, providerMessageId])
  @@index([status, createdAt])
}

model ReviewEmailEvent {
  id                    String              @id @default(uuid())
  snsMessageId          String              @unique @db.VarChar(256)
  providerMessageId     String?             @db.VarChar(256)
  eventType             String?             @db.VarChar(64)
  attemptId             String?
  status                String              @default("received") @db.VarChar(32)
  ignoredReason         String?             @db.VarChar(128)
  payloadDigest         String?             @db.VarChar(64)
  bounceType            String?             @db.VarChar(64)
  bounceSubType         String?             @db.VarChar(64)
  complaintFeedbackType String?             @db.VarChar(64)
  providerTimestamp     DateTime?
  receivedAt            DateTime            @default(now())
  processedAt           DateTime?
  attempt               ReviewEmailAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  @@index([attemptId])
  @@index([providerMessageId])
  @@index([eventType, receivedAt])
  @@index([status, receivedAt])
}

model ReviewEmailSuppression {
  id                        String    @id @default(uuid())
  storeId                   String
  emailHash                 String    @db.VarChar(128)
  emailHashKeyVersion       Int?
  emailNormalizationVersion Int       @default(1)
  reason                    String    @db.VarChar(64)
  source                    String    @db.VarChar(64)
  providerEventId           String?   @db.VarChar(256)
  createdAt                 DateTime  @default(now())
  expiresAt                 DateTime?
  releasedAt                DateTime?

  @@unique([storeId, emailHash, reason])
  @@index([storeId, emailHash])
  @@index([reason, createdAt])
}

model ReviewEmailSubjectBlock {
  id                     String   @id @default(uuid())
  storeId                String
  installationGeneration Int
  foldedSubjectHash      String   @db.VarChar(128)
  foldedHashKeyVersion   Int
  normalizationVersion   Int      @default(2)
  reason                 String   @default("subject_erasure") @db.VarChar(64)
  sourceRunId            String?  @db.VarChar(64)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([storeId, installationGeneration, foldedSubjectHash], map: "ReviewEmailSubjectBlock_subject_key")
  @@index([storeId, installationGeneration, createdAt], map: "ReviewEmailSubjectBlock_store_generation_created_idx")
}

model ReviewRequestReceipt {
  id                      String                          @id @default(uuid())
  storeId                 String
  installationGeneration  Int
  orderProductFingerprint String                          @db.VarChar(128)
  fingerprintKeyVersion   Int
  normalizationVersion    Int                             @default(2)
  exactSubjectHash        String?                         @db.VarChar(128)
  exactSubjectKeyVersion  Int?
  analyticsManifest       Json?
  analyticsClosedAt       DateTime?
  analyticsCloseReason    String?                         @db.VarChar(64)
  metricsReversedAt       DateTime?
  createdAt               DateTime                        @default(now())
  updatedAt               DateTime                        @updatedAt
  request                 ReviewRequest?
  review                  Review?
  contributions           ReviewEmailMetricContribution[]

  @@unique([storeId, installationGeneration, orderProductFingerprint], map: "ReviewRequestReceipt_order_product_key")
  @@index([storeId, installationGeneration, exactSubjectHash], map: "ReviewRequestReceipt_subject_idx")
  @@index([storeId, analyticsClosedAt, updatedAt])
}

model ReviewEmailDataSubjectRun {
  id                           String    @id @default(uuid())
  storeId                      String
  installationGeneration       Int
  action                       String    @default("erase") @db.VarChar(32)
  normalizationVersion         Int       @default(2)
  exactSubjectHash             String?   @db.VarChar(128)
  exactSubjectKeyVersion       Int?
  foldedSubjectHash            String?   @db.VarChar(128)
  foldedSubjectKeyVersion      Int?
  idempotencyKeyHash           String    @db.VarChar(64)
  requestDigest                String    @db.VarChar(64)
  requestDigestKeyVersion      Int?
  journalKey                   String?   @db.VarChar(1024)
  journalPayloadSha256         String?   @db.VarChar(64)
  journalVersionId             String?   @db.VarChar(1024)
  journalEtag                  String?   @db.VarChar(128)
  journalChecksumSha256        String?   @db.VarChar(128)
  journalRetentionBaseAt       DateTime?
  journalObjectLockRetainUntil DateTime?
  journalStatus                String    @default("pending") @db.VarChar(32)
  status                       String    @default("pending") @db.VarChar(32)
  attempts                     Int       @default(0)
  nextRetryAt                  DateTime?
  rowCounts                    Json?
  progress                     Json?
  sanitizedErrorCode           String?   @db.VarChar(128)
  subjectHashesClearedAt       DateTime?
  startedAt                    DateTime  @default(now())
  finishedAt                   DateTime?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  @@unique([storeId, idempotencyKeyHash])
  @@index([storeId, installationGeneration, createdAt], map: "ReviewEmailDSR_store_generation_created_idx")
  @@index([storeId, exactSubjectHash])
  @@index([status, nextRetryAt])
  @@index([journalStatus, createdAt])
}

model ReviewEmailDailyMetric {
  id                     String   @id @default(uuid())
  storeId                String
  installationGeneration Int
  metricDate             DateTime
  kind                   String   @db.VarChar(32)
  templateVersion        String   @db.VarChar(64)
  locale                 String   @db.VarChar(16)
  accepted               Int      @default(0)
  delivered              Int      @default(0)
  delayed                Int      @default(0)
  bounced                Int      @default(0)
  complained             Int      @default(0)
  rejected               Int      @default(0)
  failed                 Int      @default(0)
  outcomeUnknown         Int      @default(0)
  skipped                Int      @default(0)
  reviewedRequests       Int      @default(0)
  reviewsViaReminder     Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([storeId, installationGeneration, metricDate, kind, templateVersion, locale], map: "ReviewEmailDailyMetric_dimensions_key")
  @@index([storeId, installationGeneration, metricDate], map: "ReviewEmailDailyMetric_store_generation_date_idx")
}

model ReviewEmailMetricContribution {
  id                     String                @id @default(uuid())
  receiptId              String?
  storeId                String
  installationGeneration Int
  exactSubjectHash       String?               @db.VarChar(128)
  dedupeKey              String                @unique @db.VarChar(256)
  metricDate             DateTime
  kind                   String                @db.VarChar(32)
  templateVersion        String                @db.VarChar(64)
  locale                 String                @db.VarChar(16)
  metric                 String                @db.VarChar(64)
  delta                  Int
  reversedAt             DateTime?
  createdAt              DateTime              @default(now())
  receipt                ReviewRequestReceipt? @relation(fields: [receiptId], references: [id], onDelete: SetNull)

  @@index([receiptId, createdAt])
  @@index([storeId, exactSubjectHash, createdAt], map: "ReviewEmailContribution_subject_created_idx")
  @@index([reversedAt, createdAt])
}

model ReviewEmailPurgeRun {
  id                 String    @id @default(uuid())
  mode               String    @db.VarChar(16)
  status             String    @default("running") @db.VarChar(32)
  batchSize          Int       @default(100)
  batchesProcessed   Int       @default(0)
  candidates         Json?
  deleted            Json?
  elapsedMs          Int       @default(0)
  sanitizedErrorCode String?   @db.VarChar(128)
  startedAt          DateTime  @default(now())
  finishedAt         DateTime?

  @@index([status, startedAt])
  @@index([mode, startedAt])
}

model ReviewEmailJournalCoverageCheck {
  id                    String    @id @default(uuid())
  status                String    @default("running") @db.VarChar(32)
  restoreTargetAt       DateTime?
  coverageStartAt       DateTime?
  earliestSafeRestoreAt DateTime?
  checkedObjects        Int       @default(0)
  missingIntents        Int       @default(0)
  conflictingObjects    Int       @default(0)
  orphanIntents         Int       @default(0)
  details               Json?
  sanitizedErrorCode    String?   @db.VarChar(128)
  startedAt             DateTime  @default(now())
  finishedAt            DateTime?

  @@index([status, startedAt])
}

model IkasOrderReconciliationCursor {
  storeId          String    @id
  authorizedAppId  String?   @db.VarChar(128)
  lastCheckpointAt DateTime?
  overlapMinutes   Int       @default(15)
  leaseOwner       String?   @db.VarChar(128)
  leaseExpiresAt   DateTime?
  leaseVersion     Int       @default(0)
  windowStart      DateTime?
  windowEnd        DateTime?
  nextPage         Int       @default(1)
  status           String    @default("idle") @db.VarChar(32)
  lastSuccessAt    DateTime?
  lastErrorAt      DateTime?
  lastErrorCode    String?   @db.VarChar(128)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status, updatedAt])
}

model StoreDataErasureRun {
  id                     String    @id @default(uuid())
  storeId                String
  authorizedAppId        String?   @db.VarChar(128)
  installationGeneration Int?
  triggerSource          String    @db.VarChar(64)
  status                 String    @default("processing") @db.VarChar(32)
  attempts               Int       @default(0)
  nextRetryAt            DateTime?
  journalKey             String?   @db.VarChar(1024)
  journalPayloadSha256   String?   @db.VarChar(64)
  journalVersionId       String?   @db.VarChar(1024)
  journalEtag            String?   @db.VarChar(128)
  journalChecksumSha256  String?   @db.VarChar(128)
  journalRetentionBaseAt DateTime?
  journalRetainUntil     DateTime?
  journalStatus          String    @default("pending") @db.VarChar(32)
  rowCounts              Json?
  progress               Json?
  startedAt              DateTime  @default(now())
  finishedAt             DateTime?
  sanitizedErrorCode     String?   @db.VarChar(128)
  createdAt              DateTime  @default(now())

  @@index([storeId, startedAt])
  @@index([status, startedAt])
  @@index([status, nextRetryAt])
  @@index([journalStatus, startedAt])
}
