// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AuthToken {
  authorizedAppId String   @id
  merchantId      String
  salesChannelId  String?
  accessToken     String
  tokenType       String
  expiresIn       Int
  expireDate      DateTime
  refreshToken    String
  scope           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Review {
  id            String   @id @default(uuid())
  storeId       String   // Which ikas store this belongs to (merchantId)
  productId     String   // The product ID in Ikas
  slug          String   // Product slug for listing page badge lookup
  productName   String?  // The product name captured at the time of review
  rating        Int
  title         String?  // Yorum başlığı (opsiyonel)
  comment       String?
  author        String
  email         String?
  status        String   @default("pending") // pending, approved, rejected
  merchantReply String?  // Store owner's reply to the customer's review
  images        String?  // JSON stringified array of image URLs — migrate to Json? when table is empty
  helpfulCount  Int      @default(0)         // denormalized cache — ReviewHelpful sayısı
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  helpfuls      ReviewHelpful[]

  @@index([storeId, productId])          // ürün yorumları listesi
  @@index([storeId, slug])               // listing badge API
  @@index([storeId, status])             // admin panel pending/approved filtresi
  @@index([storeId, slug, status])       // approved badge sorgusu (slug + status birlikte)
}

model ReviewHelpful {
  id        String   @id @default(cuid())
  reviewId  String
  ip        String
  createdAt DateTime @default(now())

  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, ip])  // aynı IP aynı yoruma 1 kez oy
  @@index([reviewId])
}

model StoreSettings {
  id               String   @id @default(uuid())
  storeId          String   @unique
  widgetColor      String   @default("#000000")
  widgetTitle      String   @default("Müşteri Yorumları")
  autoApprove      Boolean  @default(false)
  showHelpful      Boolean  @default(true)   // "Faydalı" butonunu göster/gizle
  /// JSON map of storefrontId -> ikas scriptId, used for update-in-place instead of delete+create
  storefrontScripts Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
