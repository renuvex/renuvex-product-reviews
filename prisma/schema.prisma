generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AuthToken {
  merchantId      String
  authorizedAppId String   @id
  salesChannelId  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  accessToken     String
  tokenType       String
  expiresIn       Int
  expireDate      DateTime
  refreshToken    String
  scope           String?
}

model Review {
  id            String        @id @default(uuid())
  storeId       String
  productId     String
  rating        Int
  comment       String?       @db.VarChar(2000)
  author        String
  email         String?
  status        String        @default("pending")
  merchantReply String?       @db.VarChar(2000)
  images        String?
  hasImages     Boolean       @default(false)
  hasVideo      Boolean       @default(false)
  moderationVersion Int       @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  productName   String?
  slug          String
  title         String?
  media         ReviewMedia[]

  @@index([storeId, productId, status])
  @@index([storeId, productId, status, hasVideo])
  @@index([storeId, status])
  @@index([storeId, slug, status])
}

model ReviewMedia {
  id                String   @id @default(uuid())
  reviewId          String
  storeId           String
  productId         String
  url               String   @db.VarChar(2048)
  publicId          String   @unique @db.VarChar(512)
  assetId           String?  @db.VarChar(128)
  version           String?  @db.VarChar(64)
  resourceType      String   @default("image") @db.VarChar(32)
  provider          String   @default("cloudinary") @db.VarChar(64)
  providerAssetId   String?  @db.VarChar(512)
  posterUrl         String?  @db.VarChar(2048)
  durationMs        Int?
  processingStatus  String   @default("ready") @db.VarChar(32)
  sourceProvider    String?  @db.VarChar(64)
  sourceAssetId     String?  @db.VarChar(1024)
  format            String?  @db.VarChar(32)
  mimeType          String?  @db.VarChar(128)
  width             Int?
  height            Int?
  bytes             Int?
  metadataSource    String   @default("unknown") @db.VarChar(64)
  metadataStatus    String   @default("pending") @db.VarChar(64)
  metadataFetchedAt DateTime?
  position          Int
  visible           Boolean  @default(false)
  createdAt         DateTime @default(now())
  review            Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, position])
  @@index([reviewId, position])
  @@index([storeId, productId, visible, createdAt])
  @@index([metadataStatus, createdAt])
  @@index([provider, providerAssetId])
  @@index([processingStatus, createdAt])
}

model ProductReviewSummary {
  id                String    @id @default(uuid())
  storeId           String
  productId         String
  approvedCount     Int       @default(0)
  ratingSum         Int       @default(0)
  averageRating     Float     @default(0)
  rating1Count      Int       @default(0)
  rating2Count      Int       @default(0)
  rating3Count      Int       @default(0)
  rating4Count      Int       @default(0)
  rating5Count      Int       @default(0)
  photoReviewCount  Int       @default(0)
  photoRating1Count Int       @default(0)
  photoRating2Count Int       @default(0)
  photoRating3Count Int       @default(0)
  photoRating4Count Int       @default(0)
  photoRating5Count Int       @default(0)
  lastReviewAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([storeId, productId])
}

model StoreSettings {
  id                String   @id @default(uuid())
  storeId           String   @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  /// JSON map of storefrontId -> ikas scriptId
  storefrontScripts Json?
  /// Non-sensitive published storefront/theme metadata for runtime adapter selection
  storefrontTheme   Json?
  /// Monthly video-review quota. Zero keeps video uploads disabled for the store.
  videoMonthlyLimit Int      @default(0)
}

model WidgetSettings {
  id        String   @id @default(uuid())
  storeId   String
  widgetId  String
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, widgetId])
  @@index([storeId])
}

model ProductSnapshot {
  id            String    @id @default(uuid())
  storeId       String
  productId     String
  slug          String?
  name          String?
  ikasUpdatedAt DateTime?
  lastSyncedAt  DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([storeId, productId])
  @@index([storeId, slug])
}

// Provider-agnostic registry of uploads that are not yet attached to a Review.
// The legacy model name is intentionally retained for additive migration
// safety. Provider-specific cleanup is routed through the media adapters.
// See ADR_0012 and ADR_0031 for the lifecycle contracts.
model PendingReviewImage {
  publicId          String   @id
  storeId           String?
  productId         String?
  uploadSessionId   String?  @unique
  url               String?  @db.VarChar(2048)
  assetId           String?  @db.VarChar(128)
  version           String?  @db.VarChar(64)
  resourceType      String   @default("image") @db.VarChar(32)
  provider          String   @default("cloudinary") @db.VarChar(64)
  providerAssetId   String?  @db.VarChar(512)
  posterUrl         String?  @db.VarChar(2048)
  durationMs        Int?
  processingStatus  String   @default("ready") @db.VarChar(32)
  sourceProvider    String?  @db.VarChar(64)
  sourceAssetId     String?  @db.VarChar(1024)
  format            String?  @db.VarChar(32)
  mimeType          String?  @db.VarChar(128)
  width             Int?
  height            Int?
  bytes             Int?
  metadataSource    String   @default("unknown") @db.VarChar(64)
  metadataStatus    String   @default("pending") @db.VarChar(64)
  metadataFetchedAt DateTime?
  createdAt         DateTime @default(now())
  ipHash            String?

  @@index([createdAt])
  @@index([storeId, createdAt])
  @@index([metadataStatus, createdAt])
  @@index([provider, providerAssetId])
  @@index([processingStatus, createdAt])
}

// Durable state for the R2 multipart -> Stream processing lifecycle. The
// opaque client token is never stored; only its SHA-256 hash is persisted.
model VideoUploadSession {
  id               String    @id @default(uuid())
  tokenHash        String    @unique @db.VarChar(64)
  storeId          String
  productId        String
  status           String    @default("initiated") @db.VarChar(32)
  mimeType         String    @db.VarChar(128)
  bytes            Int
  fileFingerprint  String?   @db.VarChar(128)
  r2UploadId       String?   @db.VarChar(1024)
  masterObjectKey  String    @unique @db.VarChar(1024)
  ingestObjectKey  String?   @unique @db.VarChar(1024)
  streamUid        String?   @unique @db.VarChar(128)
  publicId         String?   @unique @db.VarChar(512)
  playbackUrl      String?   @db.VarChar(2048)
  posterUrl        String?   @db.VarChar(2048)
  durationMs       Int?
  quotaState       String    @default("reserved") @db.VarChar(32)
  reservedMonth    DateTime  @db.Date
  expiresAt        DateTime
  consumedAt       DateTime?
  errorCode        String?   @db.VarChar(128)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([storeId, productId, status])
  @@index([status, expiresAt])
  @@index([createdAt])
}

// Monthly quota counters. Reservations are taken before a multipart upload is
// created so concurrent initiate requests cannot oversubscribe a merchant.
model StoreVideoUsage {
  storeId       String
  month         DateTime @db.Date
  reservedCount Int      @default(0)
  consumedCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@id([storeId, month])
  @@index([month])
}

// Transactional outbox for provider mutations. Provider ids survive review or
// pending-row deletion and every action is idempotent through dedupeKey.
model MediaProviderJob {
  id              String    @id @default(uuid())
  dedupeKey       String    @unique @db.VarChar(256)
  storeId         String?
  reviewId        String?
  mediaId         String?
  uploadSessionId String?
  provider        String    @db.VarChar(64)
  action          String    @db.VarChar(64)
  resourceType    String    @db.VarChar(32)
  payload         Json
  status          String    @default("pending") @db.VarChar(32)
  attempts        Int       @default(0)
  maxAttempts     Int       @default(8)
  availableAt     DateTime  @default(now())
  lockedAt        DateTime?
  completedAt     DateTime?
  lastErrorCode   String?   @db.VarChar(128)
  lastErrorAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, availableAt])
  @@index([provider, action, createdAt])
  @@index([uploadSessionId])
  @@index([reviewId])
}

// Short-lived provider mutation lease. The monotonically increasing version is
// a fencing token, so a worker that outlives its lease cannot be treated as the
// current owner when it records its result.
model MediaProviderLease {
  key          String   @id @db.VarChar(256)
  ownerJobId   String
  leaseVersion Int      @default(1)
  lockedUntil  DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([lockedUntil])
}

// --- Cleanup hardening (ADR_0030) -------------------------------------------

// Audit log: one durable row per cleanup-images cron run. Records what the
// orphan cleanup scanned / quarantined / released / deleted, whether the safety
// breaker tripped (and why), and a sample of deleted publicIds for recovery.
model MediaCleanupRun {
  id             String    @id @default(uuid())
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  status         String    @default("ok") @db.VarChar(32) // ok | tripped | error | skipped
  trigger        String    @default("cron") @db.VarChar(32) // cron | manual
  scanned        Int       @default(0)
  usedCount      Int       @default(0)
  candidates     Int       @default(0) // current orphans flagged this run
  quarantinedNew Int       @default(0) // newly added to quarantine this run
  released       Int       @default(0) // un-quarantined (no longer orphan) this run
  deleted        Int       @default(0) // hard-deleted (swept) this run
  breakerTripped Boolean   @default(false)
  breakerReason  String?   @db.VarChar(128)
  forced         Boolean   @default(false)
  sampleDeleted  Json? // up to ~50 deleted publicIds, for forensics/recovery
  error          String?   @db.VarChar(512)
  durationMs     Int?

  @@index([startedAt])
  @@index([status, startedAt])
}

// Two-phase orphan deletion (ADR_0030). The monthly cleanup-images cron MARKS an
// orphan here (phase 1) instead of deleting it; a later run hard-DELETES it
// (phase 2) only if it is still orphaned after the grace window. Rows are
// removed automatically when an asset stops being an orphan (e.g. its review is
// re-found), giving a recoverable grace period before any irreversible delete.
model OrphanImageQuarantine {
  publicId      String   @id @db.VarChar(512)
  storeId       String?
  reason        String   @default("orphan_scan") @db.VarChar(64)
  quarantinedAt DateTime @default(now())
  lastSeenAt    DateTime @default(now()) // last run it was still seen as orphan
  scanCount     Int      @default(1) // number of runs it has been flagged

  @@index([quarantinedAt])
  @@index([storeId])
}
