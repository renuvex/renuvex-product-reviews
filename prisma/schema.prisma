generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AuthToken {
  merchantId      String
  authorizedAppId String   @id
  salesChannelId  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  accessToken     String
  tokenType       String
  expiresIn       Int
  expireDate      DateTime
  refreshToken    String
  scope           String?
}

model Review {
  id            String   @id @default(uuid())
  storeId       String
  productId     String
  rating        Int
  comment       String?  @db.VarChar(2000)
  author        String
  email         String?
  status        String   @default("pending")
  merchantReply String?  @db.VarChar(2000)
  images        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  productName   String?
  slug          String
  title         String?

  @@index([storeId, productId])
  @@index([storeId, slug])
  @@index([storeId, status])
  @@index([storeId, slug, status])
}

model StoreSettings {
  id                String   @id @default(uuid())
  storeId           String   @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  /// JSON map of storefrontId -> ikas scriptId
  storefrontScripts Json?
}

model WidgetSettings {
  id        String   @id @default(uuid())
  storeId   String
  widgetId  String
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, widgetId])
  @@index([storeId])
}

// Registry of Cloudinary uploads that are not yet attached to a Review.
// Created when the widget reports a successful upload; removed atomically
// when a review is submitted with that publicId. The cleanup cron expires
// rows older than the retention window and deletes the orphaned Cloudinary
// asset. See ADR_0012 for the rationale.
model PendingReviewImage {
  publicId  String   @id
  createdAt DateTime @default(now())
  ipHash    String?

  @@index([createdAt])
}
