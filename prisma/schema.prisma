generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AuthToken {
  merchantId      String
  authorizedAppId String   @id
  salesChannelId  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  accessToken     String
  tokenType       String
  expiresIn       Int
  expireDate      DateTime
  refreshToken    String
  scope           String?
}

model Review {
  id            String        @id @default(uuid())
  storeId       String
  productId     String
  rating        Int
  comment       String?       @db.VarChar(2000)
  author        String
  email         String?
  status        String        @default("pending")
  merchantReply String?       @db.VarChar(2000)
  images        String?
  hasImages     Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  productName   String?
  slug          String
  title         String?
  media         ReviewMedia[]

  @@index([storeId, productId, status])
  @@index([storeId, status])
  @@index([storeId, slug, status])
}

model ReviewMedia {
  id        String   @id @default(uuid())
  reviewId  String
  storeId   String
  productId String
  url       String   @db.VarChar(2048)
  publicId  String   @unique @db.VarChar(512)
  position  Int
  visible   Boolean  @default(false)
  createdAt DateTime @default(now())
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, position])
  @@index([reviewId, position])
  @@index([storeId, productId, visible, createdAt])
}

model ProductReviewSummary {
  id                String    @id @default(uuid())
  storeId           String
  productId         String
  approvedCount     Int       @default(0)
  ratingSum         Int       @default(0)
  averageRating     Float     @default(0)
  rating1Count      Int       @default(0)
  rating2Count      Int       @default(0)
  rating3Count      Int       @default(0)
  rating4Count      Int       @default(0)
  rating5Count      Int       @default(0)
  photoReviewCount  Int       @default(0)
  photoRating1Count Int       @default(0)
  photoRating2Count Int       @default(0)
  photoRating3Count Int       @default(0)
  photoRating4Count Int       @default(0)
  photoRating5Count Int       @default(0)
  lastReviewAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([storeId, productId])
}

model StoreSettings {
  id                String   @id @default(uuid())
  storeId           String   @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  /// JSON map of storefrontId -> ikas scriptId
  storefrontScripts Json?
  /// Non-sensitive published storefront/theme metadata for runtime adapter selection
  storefrontTheme   Json?
}

model WidgetSettings {
  id        String   @id @default(uuid())
  storeId   String
  widgetId  String
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, widgetId])
  @@index([storeId])
}

model ProductSnapshot {
  id            String    @id @default(uuid())
  storeId       String
  productId     String
  slug          String?
  name          String?
  ikasUpdatedAt DateTime?
  lastSyncedAt  DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([storeId, productId])
  @@index([storeId, slug])
}

// Registry of Cloudinary uploads that are not yet attached to a Review.
// Created when the widget reports a successful upload; removed atomically
// when a review is submitted with that publicId. The cleanup cron expires
// rows older than the retention window and deletes the orphaned Cloudinary
// asset. See ADR_0012 for the rationale.
model PendingReviewImage {
  publicId  String   @id
  storeId   String?
  createdAt DateTime @default(now())
  ipHash    String?

  @@index([createdAt])
  @@index([storeId, createdAt])
}
