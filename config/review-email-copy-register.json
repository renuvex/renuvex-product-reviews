      "maximumRestoreWindowDays": 0,
      "containsReviewEmailPii": false,
      "policy": "prohibited"
    },
    {
      "id": "vercel-function-logs",
      "restorable": false,
      "maximumRestoreWindowDays": 0,
      "containsReviewEmailPii": false,
      "policy": "sanitized-only"
    },
    {
      "id": "sentry-events",
      "restorable": false,
      "maximumRestoreWindowDays": 0,
      "containsReviewEmailPii": false,
      "policy": "send-default-pii-disabled"
    }
  ],
  "journal": {
    "minimumActiveRetentionDays": 35,
    "versionTailDays": 7,
    "calculation": "max(35,longestRegisteredDatabaseRestoreWindowDays+5)"
