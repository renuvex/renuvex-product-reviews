{
  "Statement": [
    {
      "Sid": "AllowInPlaceFoundationUpdates",
      "Effect": "Allow",
      "Action": "Update:*",
      "Principal": "*",
      "Resource": "*"
    },
    {
      "Sid": "DenyFoundationResourceDeletionOrReplacement",
      "Effect": "Deny",
      "Action": [
        "Update:Delete",
        "Update:Replace"
      ],
      "Principal": "*",
      "Resource": [
        "LogicalResourceId/ReviewEmailEventsKey",
        "LogicalResourceId/ReviewEmailEventsKeyAlias",
        "LogicalResourceId/ReviewEmailEventsTopic",
        "LogicalResourceId/ReviewEmailEventsTopicPolicy",
        "LogicalResourceId/ReviewEmailEventsDlq",
        "LogicalResourceId/ReviewEmailEventsDlqPolicy",
        "LogicalResourceId/ReviewEmailEventsHttpsSubscription",
        "LogicalResourceId/ReviewEmailConfigurationSet",
        "LogicalResourceId/ReviewEmailConfigurationSetEventDestination",
        "LogicalResourceId/ReviewEmailIdentity"
      ]
    }
  ]
}
