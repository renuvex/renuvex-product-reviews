{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Source-controlled IAM Identity Center operator and least-privilege CloudFormation service roles for Renuvex review-email infrastructure. Bootstrap in eu-central-1 only after explicit approval.",
  "Parameters": {
    "IdentityCenterInstanceArn": {
      "Type": "String",
      "AllowedPattern": "^arn:aws(-[a-z]{1,5}){0,3}:sso:::instance/(sso)?ins-[a-zA-Z0-9-.]{16}$",
      "Description": "IAM Identity Center instance ARN. Supplied only during the approved bootstrap."
    },
    "IdentityStoreId": {
      "Type": "String",
      "AllowedPattern": "^d-[0-9a-f]{10}$|^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "Description": "Identity Store identifier. Supplied only during the approved bootstrap."
    },
    "OperatorUserId": {
      "Type": "String",
      "AllowedPattern": "^([0-9a-f]{10}-|)[A-Fa-f0-9]{8}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{12}$",
      "Description": "Identity Center user identifier assigned to the operator group. Never commit the live identifier."
    },
    "TargetAccountId": {
      "Type": "String",
      "Default": "989086371563",
      "AllowedValues": [
        "989086371563"
      ],
      "Description": "Locked production AWS account for review-email infrastructure."
    },
    "DeploymentRegion": {
      "Type": "String",
      "Default": "eu-central-1",
      "AllowedValues": [
        "eu-central-1"
      ],
      "Description": "Locked AWS region for review-email infrastructure."
    },
    "JournalBucketName": {
      "Type": "String",
      "Default": "renuvex-review-email-erasure-journal-prod-989086371563-euc1",
      "AllowedValues": [
        "renuvex-review-email-erasure-journal-prod-989086371563-euc1"
      ],
      "Description": "Locked journal bucket managed by the journal CloudFormation service role."
    },
    "ApprovedFoundationChangeSetName": {
      "Type": "String",
      "Default": "approval-disabled",
      "AllowedPattern": "^approval-disabled$|^renuvex-review-email-foundation-[a-z0-9][a-z0-9-]{0,95}$",
      "Description": "Exact foundation change-set name staged by an administrator. The disabled default cannot satisfy the create/execute prefix condition."
    },
    "FoundationExecutionApprovalExpiresAt": {
      "Type": "String",
      "Default": "1970-01-01T00:00:00Z",
      "AllowedPattern": "^1970-01-01T00:00:00Z$|^20[0-9]{2}-(0[1-9]|1[0-2])-([0-2][0-9]|3[0-1])T([0-1][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$",
      "Description": "UTC expiry for the exact foundation ExecuteChangeSet authorization."
    },
    "ApprovedJournalChangeSetName": {
      "Type": "String",
      "Default": "approval-disabled",
      "AllowedPattern": "^approval-disabled$|^renuvex-review-email-journal-[a-z0-9][a-z0-9-]{0,95}$",
      "Description": "Exact journal change-set name staged by an administrator."
    },
    "JournalExecutionApprovalExpiresAt": {
      "Type": "String",
      "Default": "1970-01-01T00:00:00Z",
      "AllowedPattern": "^1970-01-01T00:00:00Z$|^20[0-9]{2}-(0[1-9]|1[0-2])-([0-2][0-9]|3[0-1])T([0-1][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$",
      "Description": "UTC expiry for the exact journal ExecuteChangeSet authorization."
    },
    "ApprovedJournalIamChangeSetName": {
      "Type": "String",
      "Default": "approval-disabled",
      "AllowedPattern": "^approval-disabled$|^renuvex-review-email-journal-iam-[a-z0-9][a-z0-9-]{0,95}$",
      "Description": "Exact journal-IAM change-set name staged by an administrator."
    },
    "JournalIamExecutionApprovalExpiresAt": {
      "Type": "String",
      "Default": "1970-01-01T00:00:00Z",
      "AllowedPattern": "^1970-01-01T00:00:00Z$|^20[0-9]{2}-(0[1-9]|1[0-2])-([0-2][0-9]|3[0-1])T([0-1][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$",
      "Description": "UTC expiry for the exact journal-IAM ExecuteChangeSet authorization."
    }
  },
  "Resources": {
    "ReviewEmailOperatorsGroup": {
      "Type": "AWS::IdentityStore::Group",
      "Properties": {
        "DisplayName": "RenuvexReviewEmailOperators",
        "Description": "Operators allowed to execute reviewed change sets for Renuvex review-email infrastructure.",
        "IdentityStoreId": {
          "Ref": "IdentityStoreId"
        }
      }
    },
    "ReviewEmailOperatorMembership": {
      "Type": "AWS::IdentityStore::GroupMembership",
      "Properties": {
        "GroupId": {
          "Fn::GetAtt": [
            "ReviewEmailOperatorsGroup",
            "GroupId"
          ]
        },
        "IdentityStoreId": {
          "Ref": "IdentityStoreId"
        },
        "MemberId": {
          "UserId": {
            "Ref": "OperatorUserId"
          }
        }
      }
    },
    "ReviewEmailOperatorPermissionSet": {
      "Type": "AWS::SSO::PermissionSet",
      "Properties": {
        "InstanceArn": {
          "Ref": "IdentityCenterInstanceArn"
        },
        "Name": "RenuvexReviewEmailOperator",
        "Description": "Change-set-only operator for the three approved Renuvex review-email stacks.",
        "SessionDuration": "PT2H",
        "InlinePolicy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "ValidateAndListCloudFormation",
              "Effect": "Allow",
              "Action": [
                "cloudformation:DescribeAccountLimits",
                "cloudformation:GetTemplateSummary",
                "cloudformation:ListStacks",
                "cloudformation:ValidateTemplate"
              ],
              "Resource": "*",
              "Condition": {
                "StringEquals": {
                  "aws:RequestedRegion": {
                    "Ref": "DeploymentRegion"
                  }
                }
              }
            },
            {
              "Sid": "CreateFoundationChangeSetWithFoundationRole",
              "Effect": "Allow",
              "Action": "cloudformation:CreateChangeSet",
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:cloudformation:${DeploymentRegion}:${TargetAccountId}:stack/renuvex-review-email-foundation-prod/*"
              },
              "Condition": {
                "StringEquals": {
                  "aws:RequestedRegion": {
                    "Ref": "DeploymentRegion"
                  },
                  "aws:RequestTag/Environment": "production",
                  "aws:RequestTag/Project": "renuvex-product-reviews",
                  "aws:RequestTag/Purpose": "review-request-email",
                  "cloudformation:ChangeSetName": {
                    "Ref": "ApprovedFoundationChangeSetName"
                  },
                  "cloudformation:RoleArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:iam::${TargetAccountId}:role/renuvex/review-email/cloudformation/renuvex-review-email-foundation-cfn"
                  }
                },
                "StringLike": {
                  "aws:RequestTag/SourceCommit": "????????????????????????????????????????",
                  "aws:RequestTag/TemplateDigest": "????????????????????????????????????????????????????????????????",
                  "cloudformation:ChangeSetName": "renuvex-review-email-foundation-*"
                },
                "ForAllValues:StringEquals": {
                  "aws:TagKeys": [
                    "Environment",
                    "Project",
                    "Purpose",
                    "SourceCommit",
                    "TemplateDigest"
                  ],
                  "cloudformation:ResourceTypes": [
                    "AWS::KMS::Alias",
                    "AWS::KMS::Key",
                    "AWS::SES::ConfigurationSet",
                    "AWS::SES::ConfigurationSetEventDestination",
                    "AWS::SES::EmailIdentity",
                    "AWS::SNS::Subscription",
                    "AWS::SNS::Topic",
                    "AWS::SNS::TopicPolicy",
                    "AWS::SQS::Queue",
                    "AWS::SQS::QueuePolicy"
                  ]
                },
                "Null": {
                  "aws:TagKeys": "false",
                  "cloudformation:ImportResourceTypes": "true",
                  "cloudformation:ResourceTypes": "false"
                }
              }
            },
            {
              "Sid": "CreateJournalChangeSetWithJournalRole",
              "Effect": "Allow",
              "Action": "cloudformation:CreateChangeSet",
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:cloudformation:${DeploymentRegion}:${TargetAccountId}:stack/renuvex-review-email-erasure-journal-prod/*"
              },
              "Condition": {
                "StringEquals": {
                  "aws:RequestedRegion": {
                    "Ref": "DeploymentRegion"
                  },
                  "aws:RequestTag/Environment": "production",
                  "aws:RequestTag/Project": "renuvex-product-reviews",
                  "aws:RequestTag/Purpose": "review-email-erasure-journal",
                  "cloudformation:ChangeSetName": {
                    "Ref": "ApprovedJournalChangeSetName"
                  },
                  "cloudformation:RoleArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:iam::${TargetAccountId}:role/renuvex/review-email/cloudformation/renuvex-review-email-journal-cfn"
                  }
                },
                "StringLike": {
                  "aws:RequestTag/SourceCommit": "????????????????????????????????????????",
                  "aws:RequestTag/TemplateDigest": "????????????????????????????????????????????????????????????????",
                  "cloudformation:ChangeSetName": "renuvex-review-email-journal-*"
                },
                "ForAllValues:StringEquals": {
                  "aws:TagKeys": [
                    "Environment",
                    "Project",
                    "Purpose",
                    "SourceCommit",
                    "TemplateDigest"
                  ],
                  "cloudformation:ResourceTypes": [
                    "AWS::S3::Bucket",
                    "AWS::S3::BucketPolicy"
                  ]
                },
                "Null": {
                  "aws:TagKeys": "false",
                  "cloudformation:ImportResourceTypes": "true",
                  "cloudformation:ResourceTypes": "false"
                }
              }
            },
            {
              "Sid": "CreateJournalIamChangeSetWithJournalIamRole",
              "Effect": "Allow",
              "Action": "cloudformation:CreateChangeSet",
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:cloudformation:${DeploymentRegion}:${TargetAccountId}:stack/renuvex-review-email-erasure-journal-iam-prod/*"
              },
              "Condition": {
                "StringEquals": {
                  "aws:RequestedRegion": {
                    "Ref": "DeploymentRegion"
                  },
                  "aws:RequestTag/Environment": "production",
                  "aws:RequestTag/Project": "renuvex-product-reviews",
                  "aws:RequestTag/Purpose": "review-email-erasure-journal-iam",
                  "cloudformation:ChangeSetName": {
                    "Ref": "ApprovedJournalIamChangeSetName"
                  },
                  "cloudformation:RoleArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:iam::${TargetAccountId}:role/renuvex/review-email/cloudformation/renuvex-review-email-journal-iam-cfn"
                  }
                },
                "StringLike": {
                  "aws:RequestTag/SourceCommit": "????????????????????????????????????????",
                  "aws:RequestTag/TemplateDigest": "????????????????????????????????????????????????????????????????",
                  "cloudformation:ChangeSetName": "renuvex-review-email-journal-iam-*"
                },
                "ForAllValues:StringEquals": {
                  "aws:TagKeys": [
                    "Environment",
                    "Project",
                    "Purpose",
                    "SourceCommit",
                    "TemplateDigest"
                  ]
                },
                "Null": {
                  "aws:TagKeys": "false",
                  "cloudformation:ImportResourceTypes": "true",
                  "cloudformation:ResourceTypes": "true"
                }
              }
            },
            {
              "Sid": "InspectApprovedReviewEmailChangeSets",
              "Effect": "Allow",
              "Action": [
                "cloudformation:DescribeChangeSet",
                "cloudformation:DescribeStackEvents",
                "cloudformation:DescribeStackResource",
                "cloudformation:DescribeStackResources",
                "cloudformation:DescribeStacks",
                "cloudformation:GetStackPolicy",
                "cloudformation:GetTemplate",
                "cloudformation:ListChangeSets",
                "cloudformation:ListStackResources"
              ],
              "Resource": [
                {
                  "Fn::Sub": "arn:${AWS::Partition}:cloudformation:${DeploymentRegion}:${TargetAccountId}:stack/renuvex-review-email-foundation-prod/*"
                },
                {
                  "Fn::Sub": "arn:${AWS::Partition}:cloudformation:${DeploymentRegion}:${TargetAccountId}:stack/renuvex-review-email-erasure-journal-prod/*"
                },
                {
                  "Fn::Sub": "arn:${AWS::Partition}:cloudformation:${DeploymentRegion}:${TargetAccountId}:stack/renuvex-review-email-erasure-journal-iam-prod/*"
                }
              ],
              "Condition": {
                "StringEquals": {
                  "aws:RequestedRegion": {
                    "Ref": "DeploymentRegion"
                  }
                }
              }
            },
            {
              "Sid": "ExecuteApprovedFoundationChangeSet",
              "Effect": "Allow",
              "Action": "cloudformation:ExecuteChangeSet",
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:cloudformation:${DeploymentRegion}:${TargetAccountId}:stack/renuvex-review-email-foundation-prod/*"
              },
              "Condition": {
                "StringEquals": {
                  "aws:RequestedRegion": {
                    "Ref": "DeploymentRegion"
                  },
                  "cloudformation:ChangeSetName": {
                    "Ref": "ApprovedFoundationChangeSetName"
                  }
                },
                "StringLike": {
                  "cloudformation:ChangeSetName": "renuvex-review-email-foundation-*"
                },
                "DateLessThan": {
                  "aws:CurrentTime": {
                    "Ref": "FoundationExecutionApprovalExpiresAt"
                  }
                }
              }
            },
            {
              "Sid": "ExecuteApprovedJournalChangeSet",
              "Effect": "Allow",
              "Action": "cloudformation:ExecuteChangeSet",
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:cloudformation:${DeploymentRegion}:${TargetAccountId}:stack/renuvex-review-email-erasure-journal-prod/*"
              },
              "Condition": {
                "StringEquals": {
                  "aws:RequestedRegion": {
                    "Ref": "DeploymentRegion"
                  },
                  "cloudformation:ChangeSetName": {
                    "Ref": "ApprovedJournalChangeSetName"
                  }
                },
                "StringLike": {
                  "cloudformation:ChangeSetName": "renuvex-review-email-journal-*"
                },
                "DateLessThan": {
                  "aws:CurrentTime": {
                    "Ref": "JournalExecutionApprovalExpiresAt"
                  }
                }
              }
            },
            {
              "Sid": "ExecuteApprovedJournalIamChangeSet",
              "Effect": "Allow",
              "Action": "cloudformation:ExecuteChangeSet",
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:cloudformation:${DeploymentRegion}:${TargetAccountId}:stack/renuvex-review-email-erasure-journal-iam-prod/*"
              },
              "Condition": {
                "StringEquals": {
                  "aws:RequestedRegion": {
                    "Ref": "DeploymentRegion"
                  },
                  "cloudformation:ChangeSetName": {
                    "Ref": "ApprovedJournalIamChangeSetName"
                  }
                },
                "StringLike": {
                  "cloudformation:ChangeSetName": "renuvex-review-email-journal-iam-*"
                },
                "DateLessThan": {
                  "aws:CurrentTime": {
                    "Ref": "JournalIamExecutionApprovalExpiresAt"
                  }
                }
              }
            },
            {
              "Sid": "InspectApprovedReviewEmailChangeSetEvents",
              "Effect": "Allow",
              "Action": "cloudformation:DescribeEvents",
              "Resource": [
                {
                  "Fn::Sub": "arn:${AWS::Partition}:cloudformation:${DeploymentRegion}:${TargetAccountId}:stack/renuvex-review-email-foundation-prod/*"
                },
                {
                  "Fn::Sub": "arn:${AWS::Partition}:cloudformation:${DeploymentRegion}:${TargetAccountId}:stack/renuvex-review-email-erasure-journal-prod/*"
                },
                {
                  "Fn::Sub": "arn:${AWS::Partition}:cloudformation:${DeploymentRegion}:${TargetAccountId}:stack/renuvex-review-email-erasure-journal-iam-prod/*"
                },
                {
                  "Fn::Sub": "arn:${AWS::Partition}:cloudformation:${DeploymentRegion}:${TargetAccountId}:changeSet/renuvex-review-email-*/*"
                }
              ],
              "Condition": {
                "StringEquals": {
                  "aws:RequestedRegion": {
                    "Ref": "DeploymentRegion"
                  }
                }
              }
            },
            {
              "Sid": "PassOnlyApprovedCloudFormationServiceRoles",
              "Effect": "Allow",
              "Action": "iam:PassRole",
              "Resource": [
                {
                  "Fn::Sub": "arn:${AWS::Partition}:iam::${TargetAccountId}:role/renuvex/review-email/cloudformation/renuvex-review-email-foundation-cfn"
                },
                {
                  "Fn::Sub": "arn:${AWS::Partition}:iam::${TargetAccountId}:role/renuvex/review-email/cloudformation/renuvex-review-email-journal-cfn"
                },
                {
                  "Fn::Sub": "arn:${AWS::Partition}:iam::${TargetAccountId}:role/renuvex/review-email/cloudformation/renuvex-review-email-journal-iam-cfn"
                }
              ],
              "Condition": {
                "StringEquals": {
                  "iam:PassedToService": "cloudformation.amazonaws.com"
                }
              }
            }
          ]
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "renuvex-product-reviews"
          },
          {
            "Key": "Purpose",
            "Value": "review-email-deployment-access"
          }
        ]
      }
    },
    "ReviewEmailOperatorAssignment": {
      "Type": "AWS::SSO::Assignment",
      "Properties": {
        "InstanceArn": {
          "Ref": "IdentityCenterInstanceArn"
        },
        "PermissionSetArn": {
          "Fn::GetAtt": [
            "ReviewEmailOperatorPermissionSet",
            "PermissionSetArn"
          ]
        },
        "PrincipalId": {
          "Fn::GetAtt": [
            "ReviewEmailOperatorsGroup",
            "GroupId"
          ]
        },
        "PrincipalType": "GROUP",
        "TargetId": {
          "Ref": "TargetAccountId"
        },
        "TargetType": "AWS_ACCOUNT"
      }
    },
    "ReviewEmailFoundationCloudFormationRole": {
      "Type": "AWS::IAM::Role",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "RoleName": "renuvex-review-email-foundation-cfn",
        "Path": "/renuvex/review-email/cloudformation/",
        "Description": "CloudFormation service role for the Renuvex review-email SES foundation stack.",
        "MaxSessionDuration": 3600,
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "AllowCloudFormationService",
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudformation.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "review-email-foundation-cloudformation",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "CreateSymmetricReviewEmailKmsKey",
                  "Effect": "Allow",
                  "Action": "kms:CreateKey",
                  "Resource": "*",
                  "Condition": {
                    "StringEquals": {
                      "aws:RequestedRegion": {
                        "Ref": "DeploymentRegion"
                      },
                      "aws:RequestTag/Environment": "production",
                      "aws:RequestTag/Project": "renuvex-product-reviews",
                      "aws:RequestTag/Purpose": "review-request-email",
                      "kms:KeySpec": "SYMMETRIC_DEFAULT",
                      "kms:KeyUsage": "ENCRYPT_DECRYPT"
                    },
                    "Bool": {
                      "kms:MultiRegion": "false"
                    }
                  }
                },
                {
                  "Sid": "TagReviewEmailKmsKey",
                  "Effect": "Allow",
                  "Action": "kms:TagResource",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:kms:${DeploymentRegion}:${TargetAccountId}:key/*"
                  },
                  "Condition": {
                    "StringEquals": {
                      "aws:RequestedRegion": {
                        "Ref": "DeploymentRegion"
                      },
                      "aws:RequestTag/Environment": "production",
                      "aws:RequestTag/Project": "renuvex-product-reviews",
                      "aws:RequestTag/Purpose": "review-request-email"
                    }
                  }
                },
                {
                  "Sid": "ManageTaggedReviewEmailKmsKey",
                  "Effect": "Allow",
                  "Action": [
                    "kms:DescribeKey",
                    "kms:DisableKeyRotation",
                    "kms:EnableKeyRotation",
                    "kms:GetKeyPolicy",
                    "kms:GetKeyRotationStatus",
                    "kms:ListResourceTags",
                    "kms:PutKeyPolicy",
                    "kms:UntagResource",
                    "kms:UpdateKeyDescription"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:kms:${DeploymentRegion}:${TargetAccountId}:key/*"
                  },
                  "Condition": {
                    "StringEquals": {
                      "aws:RequestedRegion": {
                        "Ref": "DeploymentRegion"
                      },
                      "aws:ResourceTag/Environment": "production",
                      "aws:ResourceTag/Project": "renuvex-product-reviews",
                      "aws:ResourceTag/Purpose": "review-request-email"
                    }
                  }
                },
                {
                  "Sid": "ScheduleDeletionForTaggedReviewEmailKmsKey",
                  "Effect": "Allow",
                  "Action": "kms:ScheduleKeyDeletion",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:kms:${DeploymentRegion}:${TargetAccountId}:key/*"
                  },
                  "Condition": {
                    "StringEquals": {
                      "aws:RequestedRegion": {
                        "Ref": "DeploymentRegion"
                      },
                      "aws:ResourceTag/Environment": "production",
                      "aws:ResourceTag/Project": "renuvex-product-reviews",
                      "aws:ResourceTag/Purpose": "review-request-email"
                    },
                    "NumericEquals": {
                      "kms:ScheduleKeyDeletionPendingWindowInDays": "7"
                    }
                  }
                },
                {
                  "Sid": "ManageExactReviewEmailKmsAlias",
                  "Effect": "Allow",
                  "Action": [
                    "kms:CreateAlias",
                    "kms:DeleteAlias",
                    "kms:UpdateAlias"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:kms:${DeploymentRegion}:${TargetAccountId}:alias/renuvex-review-email-events"
                  },
                  "Condition": {
                    "StringEquals": {
                      "aws:RequestedRegion": {
                        "Ref": "DeploymentRegion"
                      }
                    }
                  }
                },
                {
                  "Sid": "AssociateAliasWithTaggedReviewEmailKmsKey",
                  "Effect": "Allow",
                  "Action": [
                    "kms:CreateAlias",
                    "kms:UpdateAlias"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:kms:${DeploymentRegion}:${TargetAccountId}:key/*"
                  },
                  "Condition": {
                    "StringEquals": {
                      "aws:RequestedRegion": {
                        "Ref": "DeploymentRegion"
                      },
                      "aws:ResourceTag/Environment": "production",
                      "aws:ResourceTag/Project": "renuvex-product-reviews",
                      "aws:ResourceTag/Purpose": "review-request-email"
                    }
                  }
                },
                {
                  "Sid": "ListKmsKeysAndAliases",
                  "Effect": "Allow",
                  "Action": [
                    "kms:ListAliases",
                    "kms:ListKeys"
                  ],
                  "Resource": "*",
                  "Condition": {
                    "StringEquals": {
                      "aws:RequestedRegion": {
                        "Ref": "DeploymentRegion"
                      }
                    }
                  }
                },
                {
                  "Sid": "ManageExactReviewEmailSnsTopic",
                  "Effect": "Allow",
                  "Action": [
                    "sns:CreateTopic",
                    "sns:DeleteTopic",
                    "sns:GetDataProtectionPolicy",
                    "sns:GetTopicAttributes",
                    "sns:ListSubscriptionsByTopic",
                    "sns:ListTagsForResource",
                    "sns:SetTopicAttributes",
                    "sns:Subscribe",
                    "sns:TagResource",
                    "sns:UntagResource"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:sns:${DeploymentRegion}:${TargetAccountId}:renuvex-review-email-foundation-prod-events"
                  },
                  "Condition": {
                    "StringEquals": {
                      "aws:RequestedRegion": {
                        "Ref": "DeploymentRegion"
                      }
                    }
                  }
                },
                {
                  "Sid": "ManageExactReviewEmailSnsSubscription",
                  "Effect": "Allow",
                  "Action": [
                    "sns:GetSubscriptionAttributes",
                    "sns:SetSubscriptionAttributes",
                    "sns:Unsubscribe"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:sns:${DeploymentRegion}:${TargetAccountId}:renuvex-review-email-foundation-prod-events:*"
                  },
                  "Condition": {
                    "StringEquals": {
                      "aws:RequestedRegion": {
                        "Ref": "DeploymentRegion"
                      }
                    }
                  }
                },
                {
                  "Sid": "ListSnsControlPlane",
                  "Effect": "Allow",
                  "Action": [
                    "sns:ListSubscriptions",
                    "sns:ListTopics"
                  ],
                  "Resource": "*",
                  "Condition": {
                    "StringEquals": {
                      "aws:RequestedRegion": {
                        "Ref": "DeploymentRegion"
                      }
                    }
                  }
                },
                {
