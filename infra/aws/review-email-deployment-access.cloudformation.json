    "ReviewEmailJournalCloudFormationRole": {
      "Type": "AWS::IAM::Role",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "RoleName": "renuvex-review-email-journal-cfn",
        "Path": "/renuvex/review-email/cloudformation/",
        "Description": "CloudFormation service role for the immutable Renuvex review-email erasure journal bucket.",
        "MaxSessionDuration": 3600,
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "AllowCloudFormationService",
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudformation.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "review-email-journal-cloudformation",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "ManageExactJournalBucketConfiguration",
                  "Effect": "Allow",
                  "Action": [
                    "s3:CreateBucket",
                    "s3:GetBucketAcl",
