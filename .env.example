
NODE_ENV=production
NEXT_PUBLIC_GRAPH_API_URL=https://api.myikas.com/api/v2/admin/graphql
NEXT_PUBLIC_ADMIN_URL=https://{storeName}.myikas.com/admin
NEXT_PUBLIC_DEPLOY_URL=https://app.renuvex.app
# Storefront script/asset origin. This is where ikas storefronts load /widget.js from.
STOREFRONT_WIDGET_BASE_URL=https://widget.renuvex.app
# Explicit backend/API origin used by the widget runtime. Leave unset only for same-origin rollback/local compatibility.
STOREFRONT_WIDGET_API_BASE_URL=https://app.renuvex.app
# Optional cacheable public read origin used by the widget runtime. Leave unset to use STOREFRONT_WIDGET_API_BASE_URL.
STOREFRONT_WIDGET_READ_API_BASE_URL=https://widget.renuvex.app

# Supabase - https://supabase.com/dashboard/project/_/settings/database
# "Transaction" pooler URL (port 6543) -> DATABASE_URL
# "Session" pooler URL (port 5432) -> DIRECT_URL
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

SECRET_COOKIE_PASSWORD=your_session_cookie_password_here
NEXT_PUBLIC_CLIENT_ID=your_ikas_app_client_id_here
CLIENT_SECRET=your_ikas_app_client_secret_here
REVIEW_CURSOR_SECRET=your_review_cursor_hmac_secret_here

# Review images - AWS S3 + CloudFront provider (ADR_0034)
REVIEW_IMAGE_PROVIDER=aws_s3
AWS_REVIEW_IMAGES_REGION=eu-central-1
AWS_REVIEW_IMAGES_BUCKET=renuvex-review-images-prod-989086371563-eu-central-1
AWS_REVIEW_IMAGES_PUBLIC_BASE_URL=https://media.renuvex.app
AWS_REVIEW_IMAGES_ROLE_ARN=arn:aws:iam::989086371563:role/renuvex-review-images-vercel-runtime
AWS_REVIEW_IMAGES_OIDC_AUDIENCE=sts.amazonaws.com
AWS_REVIEW_IMAGES_CLOUDFRONT_DISTRIBUTION_ID=your_cloudfront_distribution_id
AWS_REVIEW_IMAGES_CLOUDFRONT_KEY_PAIR_ID=your_cloudfront_key_pair_id
AWS_REVIEW_IMAGES_CLOUDFRONT_PRIVATE_KEY_B64=your_cloudfront_private_key_base64

# Review request email - SES foundation, disabled until the email product rollout is approved
REVIEW_EMAIL_ENABLED=false
REVIEW_EMAIL_PROVIDER=ses
AWS_REVIEW_EMAIL_REGION=eu-central-1
AWS_REVIEW_EMAIL_ROLE_ARN=arn:aws:iam::989086371563:role/renuvex-review-email-vercel-runtime
AWS_REVIEW_EMAIL_OIDC_AUDIENCE=sts.amazonaws.com
AWS_REVIEW_EMAIL_FROM=requests@reviews.renuvex.app
AWS_REVIEW_EMAIL_CONFIGURATION_SET=renuvex-review-requests-prod
AWS_SES_EVENTS_SNS_TOPIC_ARN=arn:aws:sns:eu-central-1:989086371563:renuvex-review-email-foundation-prod-events

# Sentry source map upload configuration
SENTRY_ORG=your_sentry_org
SENTRY_PROJECT=renuvex-product-reviews

# Upstash Redis - REST credentials used for server-side rate limiting
KV_REST_API_URL=https://your-upstash-database.upstash.io
KV_REST_API_TOKEN=your_upstash_rest_token

# Review video - disabled unless every gate (global flag + per-merchant toggle + quota) is on
VIDEO_REVIEWS_ENABLED=false

#Environment Name = Renuvex - Product Reviews (Preview)
# Mux - video provider (ADR_0032). SERVER-ONLY; never exposed to browser/widget/API responses.
# Access token: Mux Dashboard > Settings > Access Tokens (Mux Video read+write).
MUX_TOKEN_ID=your_mux_access_token_id
MUX_TOKEN_SECRET=your_mux_access_token_secret
# Product policy for uploaded review videos. Supported app values: basic or plus.
MUX_VIDEO_QUALITY=basic
# Optional client direct-upload tuning. Defaults: 8192 KB chunks, 5 attempts.
VIDEO_UPLOAD_CHUNK_SIZE_KB=8192
VIDEO_UPLOAD_CHUNK_ATTEMPTS=5
# Webhook signing secret: Mux Dashboard > Settings > Webhooks (per endpoint).
# Fill this only after the deployed /api/webhooks/mux endpoint exists.
MUX_WEBHOOK_SECRET=your_mux_webhook_signing_secret
# URL signing key (for signed admin preview playback/thumbnail tokens):
# Mux Dashboard > Settings > Signing Keys. PRIVATE is the base64-encoded RSA private key.
MUX_SIGNING_KEY_ID=your_mux_url_signing_key_id
MUX_SIGNING_KEY_PRIVATE=your_mux_url_signing_private_key_base64

# QStash - durable provider job dispatch/retry for media lifecycle operations
QSTASH_TOKEN=your_qstash_token
QSTASH_CURRENT_SIGNING_KEY=your_qstash_current_signing_key
QSTASH_NEXT_SIGNING_KEY=your_qstash_next_signing_key
MEDIA_JOB_BASE_URL=https://your-app.vercel.app

# Cron / maintenance
CRON_SECRET=your_cron_secret
STOREFRONT_THEME_CRON_LIMIT=100
STOREFRONT_THEME_PENDING_SCAN_LIMIT=500
STOREFRONT_THEME_CRON_CONCURRENCY=5
