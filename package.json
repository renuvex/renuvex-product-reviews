{
  "name": "renuvex-product-reviews",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma generate && prisma migrate deploy && next build --webpack",
    "start": "next start",
    "lint": "eslint src",
    "codegen": "graphql-codegen --config src/lib/ikas-client/codegen.ts",
    "build:widget": "node scripts/build-widget.mjs",
    "build:widget:watch": "node scripts/build-widget.mjs --watch",
    "build:widget:new-theme": "node scripts/build-widget.mjs --theme=new-theme",
    "check:widget-js": "node scripts/check-widget-runtime.mjs",
    "test:widget-smoke": "playwright test --config=playwright.widget.config.ts tests/widget-network-smoke.spec.ts",
    "test:widget-runtime": "playwright test --config=playwright.widget.config.ts tests/widget-runtime-smoke.spec.ts",
    "test:widget-interactions": "playwright test --config=playwright.widget.config.ts tests/widget-interaction-smoke.spec.ts",
    "test:admin-preview": "playwright test --config=playwright.widget.config.ts tests/admin-preview-smoke.spec.ts",
    "test:unit": "vitest run --config=vitest.config.ts",
    "test:ci": "pnpm test:unit && pnpm test:widget-smoke && pnpm test:widget-runtime && pnpm test:widget-interactions && pnpm test:admin-preview",
    "test:widget-smoke:headed": "playwright test --config=playwright.widget.config.ts tests/widget-network-smoke.spec.ts --headed",
    "build:watch": "tsc --watch",
    "prisma:init": "prisma generate && prisma db push --accept-data-loss",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "apply:ai-rules": "npx @intellectronica/ruler apply"
  },
  "packageManager": "pnpm@10.4.1",
  "dependencies": {
    "@ikas/admin-api-client": "^2.0.11",
    "@ikas/app-helpers": "^1.0.6",
    "@prisma/client": "^6.14.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@sentry/nextjs": "^10.52.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@upstash/redis": "^1.37.0",
    "axios": "^1.10.0",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.9.0",
    "clsx": "^2.1.1",
    "graphql-request": "^7.0.0",
    "iron-session": "^8.0.4",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.542.0",
    "moment": "^2.30.1",
    "next": "16.2.1",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.6",
    "radix-ui": "^1.4.3",
    "react": "^19.0.0",
    "react-colorful": "^5.6.1",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.12",
    "uuid": "^11.1.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@graphql-codegen/cli": "^5.0.7",
    "@graphql-codegen/typescript": "^4.1.0",
    "@graphql-codegen/typescript-graphql-request": "^6.3.0",
    "@graphql-codegen/typescript-operations": "^4.6.1",
    "@playwright/test": "^1.60.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^24.3.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.30.1",
    "@typescript-eslint/parser": "^8.30.1",
    "esbuild": "^0.28.0",
    "eslint": "^9",
    "eslint-config-next": "^15.3.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prisma": "^6.14.0",
    "tw-animate-css": "^1.3.7",
    "typescript": "^5",
    "vitest": "^4.1.7"
  },
  "prettier": {
    "semi": true,
    "trailingComma": "all",
    "singleQuote": true,
    "printWidth": 150,
    "tabWidth": 2,
    "bracketSpacing": true
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@prisma/client",
      "@prisma/engines",
      "@tailwindcss/oxide",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}
