{
  "name": "renuvex-product-reviews",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma generate && prisma migrate deploy && pnpm build:widget && next build --webpack",
    "start": "next start",
    "lint": "eslint src",
    "codegen": "graphql-codegen --config src/lib/ikas-client/codegen.ts",
    "build:widget": "node scripts/build-widget.mjs",
    "build:widget:watch": "node scripts/build-widget.mjs --watch",
    "build:widget:new-theme": "node scripts/build-widget.mjs --theme=new-theme",
    "check:widget-js": "node scripts/check-widget-runtime.mjs",
    "clean:widget-runtime": "node scripts/clean-widget-runtime-untracked.mjs",
    "clean:widget-runtime:apply": "node scripts/clean-widget-runtime-untracked.mjs --apply",
    "worker:widget:prepare-assets": "node scripts/prepare-widget-worker-assets.mjs",
    "worker:widget:types": "pnpm worker:widget:prepare-assets && wrangler types workers/widget-delivery/worker-configuration.d.ts --config wrangler.widget.jsonc --env-file=.tmp/widget-worker.env --include-runtime=false",
    "worker:widget:deploy:dry-run": "pnpm worker:widget:prepare-assets && wrangler deploy --config wrangler.widget.jsonc --env-file=.tmp/widget-worker.env --dry-run",
    "worker:widget:deploy": "pnpm worker:widget:prepare-assets && wrangler deploy --config wrangler.widget.jsonc --env-file=.tmp/widget-worker.env",
    "aws:widget:prepare-assets": "node scripts/prepare-widget-aws-canary-assets.mjs",
    "aws:widget:validate-template": "node scripts/validate-widget-aws-canary-template.mjs",
    "aws:review-images:validate-template": "node scripts/validate-review-images-aws-template.mjs",
    "aws:review-images:validate-runtime-iam-template": "node scripts/validate-review-images-runtime-iam-template.mjs",
    "aws:widget:deploy-assets:dry-run": "pnpm aws:widget:prepare-assets && node scripts/deploy-widget-aws-canary-assets.mjs",
    "aws:widget:deploy-assets": "pnpm aws:widget:prepare-assets && node scripts/deploy-widget-aws-canary-assets.mjs --apply",
    "measure:deployed-widget": "node scripts/measure-deployed-widget-network.mjs",
    "measure:storefront-waterfall": "node scripts/measure-storefront-waterfall.mjs",
    "budget:widget": "node scripts/check-widget-performance-budget.mjs",
    "budget:widget:network": "node scripts/check-widget-performance-budget.mjs --include-network --warn",
    "verify:deployed-jsonld": "node scripts/verify-deployed-jsonld.mjs",
    "verify:preview-db-isolation": "node scripts/verify-preview-db-isolation.mjs",
    "verify:video-infrastructure": "node --env-file=.env.local scripts/verify-mux-infrastructure.mjs --phase=pre-webhook --expect-disabled",
    "verify:video-infrastructure:post-webhook": "node --env-file=.env.local scripts/verify-mux-infrastructure.mjs --phase=post-webhook",
    "video:canary:ops": "node --env-file=.env.local scripts/video-canary-ops.mjs",
    "video:canary:verify-disabled": "node --env-file=.env.local scripts/video-canary-ops.mjs --expect-all-disabled",
    "settings:media-gallery:migrate": "node scripts/migrate-widget-settings-media-gallery-keys.mjs",
    "test:widget-smoke": "playwright test --config=playwright.widget.config.ts tests/widget-network-smoke.spec.ts",
    "test:widget-runtime": "playwright test --config=playwright.widget.config.ts tests/widget-runtime-smoke.spec.ts",
    "test:widget-interactions": "playwright test --config=playwright.widget.config.ts tests/widget-interaction-smoke.spec.ts",
    "test:widget-media": "playwright test --config=playwright.media.config.ts tests/widget-media-cross-browser.spec.ts --project=chromium-desktop",
    "test:widget-media:chromium": "playwright test --config=playwright.media.config.ts tests/widget-media-cross-browser.spec.ts --project=chromium-desktop",
    "test:widget-media:android": "playwright test --config=playwright.media.config.ts tests/widget-media-cross-browser.spec.ts --project=pixel-android",
    "test:widget-media:ios": "playwright test --config=playwright.media.config.ts tests/widget-media-cross-browser.spec.ts --project=iphone-webkit",
    "test:widget-media:firefox": "playwright test --config=playwright.media.config.ts tests/widget-media-cross-browser.spec.ts --project=firefox-desktop",
    "test:widget-media:webkit": "playwright test --config=playwright.media.config.ts tests/widget-media-cross-browser.spec.ts --project=webkit-desktop",
    "test:admin-preview": "playwright test --config=playwright.widget.config.ts tests/admin-preview-smoke.spec.ts",
    "test:unit": "vitest run --config=vitest.config.ts",
    "test:ci": "pnpm test:unit && pnpm test:widget-smoke && pnpm test:widget-runtime && pnpm test:widget-interactions && pnpm test:admin-preview",
    "test:widget-smoke:headed": "playwright test --config=playwright.widget.config.ts tests/widget-network-smoke.spec.ts --headed",
    "build:watch": "tsc --watch",
    "prisma:init": "prisma generate && prisma db push --accept-data-loss",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "reviews:summaries:rebuild": "node scripts/rebuild-product-review-summaries.mjs",
    "apply:ai-rules": "npx @intellectronica/ruler apply"
  },
  "packageManager": "pnpm@10.4.1",
  "dependencies": {
    "@aws-sdk/client-cloudfront": "^3.1079.0",
    "@aws-sdk/client-s3": "^3.1079.0",
    "@aws-sdk/cloudfront-signer": "^3.1078.0",
    "@aws-sdk/s3-presigned-post": "^3.1079.0",
    "@ikas/admin-api-client": "^2.0.11",
    "@ikas/app-helpers": "^1.0.6",
    "@mux/mux-node": "^14.1.1",
    "@mux/mux-player": "^3.13.0",
    "@mux/upchunk": "^3.5.0",
    "@prisma/client": "^6.14.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@sentry/nextjs": "^10.52.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@upstash/qstash": "^2.11.0",
    "@upstash/redis": "^1.37.0",
    "@vercel/oidc-aws-credentials-provider": "^3.3.0",
    "axios": "^1.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "graphql-request": "^7.0.0",
    "iron-session": "^8.0.4",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.542.0",
    "media-chrome": "4.19.2",
    "moment": "^2.30.1",
    "next": "16.2.1",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.6",
    "radix-ui": "^1.4.3",
    "react": "^19.0.0",
    "react-colorful": "^5.6.1",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.12",
    "uuid": "^11.1.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@graphql-codegen/cli": "^5.0.7",
    "@graphql-codegen/typescript": "^4.1.0",
    "@graphql-codegen/typescript-graphql-request": "^6.3.0",
    "@graphql-codegen/typescript-operations": "^4.6.1",
    "@playwright/test": "^1.60.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^24.3.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.30.1",
    "@typescript-eslint/parser": "^8.30.1",
    "esbuild": "^0.28.0",
    "eslint": "^9",
    "eslint-config-next": "^15.3.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prisma": "^6.14.0",
    "tw-animate-css": "^1.3.7",
    "typescript": "^5",
    "vitest": "^4.1.7",
    "wrangler": "^4.105.0"
  },
  "prettier": {
    "semi": true,
    "trailingComma": "all",
    "singleQuote": true,
    "printWidth": 150,
    "tabWidth": 2,
    "bracketSpacing": true
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@prisma/client",
      "@prisma/engines",
      "@sentry/cli",
      "@tailwindcss/oxide",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}
